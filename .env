# Base URL do BFF. No emulador Android, 10.0.2.2 e o localhost da maquina host.
API_BASE_URL=http://10.0.2.2:8090
# Servico de Midia: upload de fotos vai direto nele (nao passa pelo BFF).
MIDIA_BASE_URL=http://10.0.2.2:8083
# WebSocket do servico de Localizacao (STOMP/SockJS): acompanhar trilha ao vivo.
LOC_WS_URL=http://10.0.2.2:8082/ws-localizacao
# Login com Google: Web client ID (OAuth 2.0) do Google Cloud. E o mesmo valor
# que vai no GOOGLE_CLIENT_ID do servico Cadastro, que valida o aud do ID token.
# Vazio: o botao aparece na tela, mas avisa que falta configurar.
GOOGLE_SERVER_CLIENT_ID=
